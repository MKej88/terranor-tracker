{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "terranor-tracker",
  "main": "src/index2.js",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "secrets": {
    "required": ["APP_PASSWORD", "SESSION_SECRET", "TRAFIKVERKET_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "terranor-tracker-db",
      "database_id": "ea2ce4f2-00e1-4769-b8a7-3a1da07e0076"
    }
  ],
  "triggers": {
    "crons": [
      "5 * * * *",
      "15 * * * *",
      "25 * * * *",
      "35 * * * *",
      "45 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
